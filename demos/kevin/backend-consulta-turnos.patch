+CREATE TABLE IF NOT EXISTS srtv_usuario_propietario (
+    usuario_id BIGINT PRIMARY KEY REFERENCES srtv_usuario(usuario_id),
+    propietario_id BIGINT NOT NULL REFERENCES pv_propietario(propietario_id),
+    activo BOOLEAN NOT NULL DEFAULT TRUE,
+    fecha_vinculacion TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE INDEX IF NOT EXISTS idx_usuario_propietario_propietario
+    ON srtv_usuario_propietario(propietario_id);
