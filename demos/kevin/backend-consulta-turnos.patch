@@ -0,0 +1,43 @@
+package com.revisionvehicular.backend.service.srtv;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+import java.time.LocalDate;
+import java.util.Optional;
+
+@Repository
+public class ConsultaTurnoAcceso {
+    private final JdbcTemplate jdbc;
+
+    public ConsultaTurnoAcceso(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    public boolean tienePermiso(String usuario, boolean escritura) {
+        String sql = """
+            SELECT count(*) FROM srtv_usuario u
+            JOIN srtv_usuario_roles ur ON ur.usuario_id = u.usuario_id
+            JOIN srtv_rol r ON r.rol_id = ur.rol_id AND r.estado = 'A'
+            JOIN srtv_rol_opcion_menu rom ON rom.rol_id = r.rol_id
+            JOIN srtv_opcion_menu om ON om.opcion_menu_id = rom.opcion_menu_id
+            WHERE u.usuario = ? AND lower(u.estado) = 'activo'
+              AND (om.clave = 'menu_turnos' OR (? = false AND om.clave IN
+                  ('menu_historial_turnos', 'menu_inspeccion_turnos_pagados')))
+            """;
+        return jdbc.queryForObject(sql, Integer.class, usuario, escritura) > 0;
+    }
+
+    public record EstadoTurno(Long turnoId, String estado, LocalDate fechaInicio, LocalDate fechaFin) {}
+
+    public Optional<EstadoTurno> consultarPropio(String usuario, Long turnoId) {
+        String sql = """
+            SELECT t.turno_id, t.estado, t.fecha_inicio, t.fecha_fin FROM srtv_usuario u
+            JOIN srtv_usuario_propietario up ON up.usuario_id = u.usuario_id AND up.activo = true
+            JOIN rtv_turnos t ON t.propietario_id = up.propietario_id
+            WHERE u.usuario = ? AND lower(u.estado) = 'activo' AND t.turno_id = ?
+            """;
+        return jdbc.query(sql, (rs, fila) -> new EstadoTurno(rs.getLong("turno_id"), rs.getString("estado"),
+                rs.getObject("fecha_inicio", LocalDate.class), rs.getObject("fecha_fin", LocalDate.class)),
+                usuario, turnoId).stream().findFirst();
+    }
+}
