@@ -0,0 +1,123 @@
+package com.revisionvehicular.backend.security;
+
+import com.revisionvehicular.backend.controllers.srtv.ConsultaTurnoController;
+import com.revisionvehicular.backend.service.srtv.ConsultaTurnoAcceso;
+import jakarta.servlet.FilterChain;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.dao.DataAccessResourceFailureException;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.context.SecurityContextHolder;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Optional;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class ConsultaTurnoAccessTest {
+    private final ConsultaTurnoAcceso acceso = mock(ConsultaTurnoAcceso.class);
+    private final ConsultaTurnoController controller = new ConsultaTurnoController(acceso);
+
+    private UsernamePasswordAuthenticationToken sesion() {
+        return new UsernamePasswordAuthenticationToken("solicitante", null, List.of());
+    }
+
+    @AfterEach
+    void limpiarContexto() { SecurityContextHolder.clearContext(); }
+
+    @Test
+    void consultaSinSesionNoAccedeALaBase() {
+        assertEquals(401, controller.consultar(22L, null).getStatusCode().value());
+        verifyNoInteractions(acceso);
+    }
+
+    @Test
+    void devuelveSoloResumenDelTurnoPropio() {
+        var turno = new ConsultaTurnoAcceso.EstadoTurno(22L, "PAGADO", LocalDate.of(2026, 3, 8), null);
+        when(acceso.consultarPropio("solicitante", 22L)).thenReturn(Optional.of(turno));
+        var respuesta = controller.consultar(22L, sesion());
+        assertEquals(200, respuesta.getStatusCode().value());
+        assertEquals(turno, respuesta.getBody());
+        assertEquals("no-store", respuesta.getHeaders().getFirst("Cache-Control"));
+    }
+
+    @Test
+    void turnoAjenoEInexistenteNoSeDistinguen() {
+        when(acceso.consultarPropio("solicitante", 22L)).thenReturn(Optional.empty());
+        when(acceso.consultarPropio("solicitante", 999L)).thenReturn(Optional.empty());
+        var ajeno = controller.consultar(22L, sesion());
+        var inexistente = controller.consultar(999L, sesion());
+        assertEquals(404, ajeno.getStatusCode().value());
+        assertEquals(ajeno.getStatusCode(), inexistente.getStatusCode());
+        assertEquals(ajeno.getBody(), inexistente.getBody());
+    }
+
+    @Test
+    void falloDeBaseNoExponeDatos() {
+        when(acceso.consultarPropio("solicitante", 22L))
+                .thenThrow(new DataAccessResourceFailureException("detalle interno"));
+        var respuesta = controller.consultar(22L, sesion());
+        assertEquals(503, respuesta.getStatusCode().value());
+        assertFalse(respuesta.getBody().toString().contains("detalle interno"));
+    }
+
+    private MockHttpServletResponse filtrar(String metodo, String ruta, boolean autenticado,
+                                            FilterChain chain) throws Exception {
+        if (autenticado) SecurityContextHolder.getContext().setAuthentication(sesion());
+        var request = new MockHttpServletRequest(metodo, ruta);
+        request.setServletPath(ruta);
+        var response = new MockHttpServletResponse();
+        new TurnosAccessFilter(acceso).doFilter(request, response, chain);
+        return response;
+    }
+
+    @Test
+    void apiInternaSinSesionQuedaCerrada() throws Exception {
+        var chain = mock(FilterChain.class);
+        assertEquals(401, filtrar("GET", "/api/turnos/22", false, chain).getStatus());
+        verifyNoInteractions(chain, acceso);
+    }
+
+    @Test
+    void solicitanteNoPuedeUsarListadoInternoComoAtajo() throws Exception {
+        var chain = mock(FilterChain.class);
+        when(acceso.tienePermiso("solicitante", false)).thenReturn(false);
+        assertEquals(403, filtrar("GET", "/api/turnos", true, chain).getStatus());
+        verifyNoInteractions(chain);
+    }
+
+    @Test
+    void personalConPermisoPuedeConsultar() throws Exception {
+        var chain = mock(FilterChain.class);
+        when(acceso.tienePermiso("solicitante", false)).thenReturn(true);
+        assertEquals(200, filtrar("GET", "/api/turnos/22", true, chain).getStatus());
+        verify(chain).doFilter(any(), any());
+    }
+
+    @Test
+    void permisoDeLecturaNoAutorizaEscritura() throws Exception {
+        var chain = mock(FilterChain.class);
+        when(acceso.tienePermiso("solicitante", true)).thenReturn(false);
+        assertEquals(403, filtrar("PATCH", "/api/turnos/22/pago", true, chain).getStatus());
+        verifyNoInteractions(chain);
+    }
+
+    @Test
+    void consultaPropiaAutenticadaLlegaAlControlador() throws Exception {
+        var chain = mock(FilterChain.class);
+        assertEquals(200, filtrar("GET", "/api/consulta/turnos/22", true, chain).getStatus());
+        verify(chain).doFilter(any(), any());
+        verifyNoInteractions(acceso);
+    }
+
+    @Test
+    void falloAlVerificarPersonalSeCierraElAcceso() throws Exception {
+        var chain = mock(FilterChain.class);
+        when(acceso.tienePermiso("solicitante", false))
+                .thenThrow(new DataAccessResourceFailureException("detalle interno"));
+        assertEquals(503, filtrar("GET", "/api/turnos/22", true, chain).getStatus());
+        verifyNoInteractions(chain);
+    }
+}
